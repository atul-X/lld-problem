<mxfile host="app.diagrams.net" modified="2026-08-17T20:55:00.000Z" agent="ChatGPT" version="24.7.17">
<diagram id="rl-study" name="Rate Limiter Complete Study">
<mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
<root>
<mxCell id="0"/><mxCell id="1" parent="0"/>

<mxCell id="title" value="RATE LIMITER — COMPLETE LLD / SDE3 STUDY MAP" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;fontColor=#17365D;align=center" vertex="1" parent="1"><mxGeometry x="500" y="20" width="1400" height="60" as="geometry"/></mxCell>

<mxCell id="what" value="WHAT IS RATE LIMITING?&lt;br&gt;&lt;br&gt;&lt;b&gt;Rate limiting controls the number of operations a client can perform during a time period.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Example: User A → maximum 100 requests/minute.&lt;br&gt;Requests above the limit are delayed or rejected, commonly with HTTP 429.&lt;br&gt;&lt;br&gt;&lt;b&gt;Goals:&lt;/b&gt; prevent abuse • protect CPU/DB/downstream APIs • enforce quotas • avoid overload • provide fairness." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#2F75B5;strokeWidth=3;fontSize=15;fontColor=#17365D;align=left;spacingLeft=15;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="700" y="100" width="1000" height="170" as="geometry"/></mxCell>

<mxCell id="why" value="WHY DO WE NEED IT?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#385723;fontColor=#FFFFFF;fontSize=19;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="50" y="320" width="500" height="50" as="geometry"/></mxCell>
<mxCell id="whybody" value="&lt;b&gt;1. Abuse protection&lt;/b&gt; → brute force, scraping, bots&lt;br&gt;&lt;b&gt;2. Service protection&lt;/b&gt; → stop traffic spikes from exhausting threads/CPU/DB connections&lt;br&gt;&lt;b&gt;3. Dependency protection&lt;/b&gt; → avoid overwhelming payment, OTP, bank or third-party APIs&lt;br&gt;&lt;b&gt;4. Quotas&lt;/b&gt; → e.g. free users 1000/day, premium users 10000/day&lt;br&gt;&lt;b&gt;5. Fairness&lt;/b&gt; → one noisy client should not consume all capacity&lt;br&gt;&lt;b&gt;6. Cost control&lt;/b&gt; → control expensive API calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=14;fontColor=#274E13;align=left;spacingLeft=15;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="50" y="390" width="500" height="220" as="geometry"/></mxCell>

<mxCell id="alg" value="ALGORITHMS — KNOW THESE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="600" y="320" width="1150" height="50" as="geometry"/></mxCell>

<mxCell id="fixed" value="&lt;b&gt;1. FIXED WINDOW&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Idea:&lt;/b&gt; divide time into fixed intervals and keep a counter.&lt;br&gt;&lt;br&gt;&lt;b&gt;Example:&lt;/b&gt; limit=100/minute.&lt;br&gt;12:00–12:01 has counter=100 → reject more.&lt;br&gt;At 12:01 counter resets.&lt;br&gt;&lt;br&gt;&lt;b&gt;Data:&lt;/b&gt; key → {count, windowStart}&lt;br&gt;&lt;b&gt;Pros:&lt;/b&gt; simplest • fast • low memory&lt;br&gt;&lt;b&gt;Cons:&lt;/b&gt; boundary burst&lt;br&gt;&lt;b&gt;Why?&lt;/b&gt; 100 req at 12:00:59 + 100 req at 12:01:01 = ~200 in 2 sec.&lt;br&gt;&lt;b&gt;Use:&lt;/b&gt; simple quotas where boundary bursts are acceptable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontColor=#4A3B00;fontSize=13;align=left;spacingLeft=12;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="600" y="390" width="360" height="285" as="geometry"/></mxCell>

<mxCell id="log" value="&lt;b&gt;2. SLIDING WINDOW LOG&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Idea:&lt;/b&gt; store timestamps of requests in the last N seconds.&lt;br&gt;&lt;br&gt;&lt;b&gt;Request:&lt;/b&gt; remove timestamps &lt; now-window; if remaining count &lt; limit → allow and append now.&lt;br&gt;&lt;br&gt;&lt;b&gt;Data:&lt;/b&gt; key → queue/deque of timestamps.&lt;br&gt;&lt;b&gt;Pros:&lt;/b&gt; very accurate&lt;br&gt;&lt;b&gt;Cons:&lt;/b&gt; memory grows with traffic; cleanup required; more Redis operations/data&lt;br&gt;&lt;b&gt;Example:&lt;/b&gt; 1000 req/sec can mean many timestamps stored across keys.&lt;br&gt;&lt;b&gt;Use:&lt;/b&gt; strict limits/security-sensitive endpoints." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DFF5;strokeColor=#7F5AA2;fontColor=#352348;fontSize=13;align=left;spacingLeft=12;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="980" y="390" width="360" height="285" as="geometry"/></mxCell>

<mxCell id="counter" value="&lt;b&gt;3. SLIDING WINDOW COUNTER&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Idea:&lt;/b&gt; keep current and previous fixed-window counts.&lt;br&gt;&lt;br&gt;&lt;b&gt;Approximation:&lt;/b&gt;&lt;br&gt;estimated = currentCount + previousCount × fractionOfPreviousWindowStillRelevant.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pros:&lt;/b&gt; low memory • efficient • smoother than fixed window&lt;br&gt;&lt;b&gt;Cons:&lt;/b&gt; approximate; requests are not individually tracked&lt;br&gt;&lt;b&gt;Example:&lt;/b&gt; previous=100, current=50; depending on elapsed fraction, only part of previous is counted.&lt;br&gt;&lt;b&gt;Use:&lt;/b&gt; high-volume APIs needing a memory/accuracy balance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#6AA84F;fontColor=#274E13;fontSize=13;align=left;spacingLeft=12;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1360" y="390" width="360" height="285" as="geometry"/></mxCell>

<mxCell id="token" value="&lt;b&gt;4. TOKEN BUCKET ⭐ RECOMMENDED BASELINE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Idea:&lt;/b&gt; bucket holds tokens. Tokens refill at a fixed rate. Each request consumes one token.&lt;br&gt;&lt;br&gt;&lt;b&gt;State:&lt;/b&gt; {tokens, lastRefill, capacity, refillRate}&lt;br&gt;&lt;b&gt;Pros:&lt;/b&gt; controlled bursts • flexible • good API fit&lt;br&gt;&lt;b&gt;Cons:&lt;/b&gt; capacity/refill tuning; large capacity permits large bursts&lt;br&gt;&lt;b&gt;Use:&lt;/b&gt; API Gateway • microservices • per-user/API-key limits." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#CC0000;strokeWidth=2;fontColor=#5B0000;fontSize=13;align=left;spacingLeft=12;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="600" y="700" width="360" height="245" as="geometry"/></mxCell>

<mxCell id="leaky" value="&lt;b&gt;5. LEAKY BUCKET&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Idea:&lt;/b&gt; requests enter a queue and leave at a fixed rate.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pros:&lt;/b&gt; smooth/predictable downstream traffic&lt;br&gt;&lt;b&gt;Cons:&lt;/b&gt; queue adds latency; queue can overflow → drop/reject&lt;br&gt;&lt;b&gt;How it fails:&lt;/b&gt; arrival rate &gt; processing rate → queue grows continuously.&lt;br&gt;&lt;b&gt;Use:&lt;/b&gt; traffic shaping when smooth output matters more than immediate execution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#6AA84F;fontColor=#274E13;fontSize=13;align=left;spacingLeft=12;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="980" y="700" width="360" height="245" as="geometry"/></mxCell>

<mxCell id="compare" value="ALGORITHM DECISION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="700" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="comparebody" value="&lt;b&gt;Simplest?&lt;/b&gt; → Fixed Window&lt;br&gt;&lt;b&gt;Exact timestamps?&lt;/b&gt; → Sliding Log&lt;br&gt;&lt;b&gt;Efficient approximation?&lt;/b&gt; → Sliding Counter&lt;br&gt;&lt;b&gt;Controlled bursts?&lt;/b&gt; → Token Bucket ⭐&lt;br&gt;&lt;b&gt;Smooth output?&lt;/b&gt; → Leaky Bucket&lt;br&gt;&lt;br&gt;&lt;b&gt;Interview default:&lt;/b&gt; Token Bucket + distributed shared state when multiple instances exist." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#2F75B5;fontSize=14;fontColor=#17365D;align=left;spacingLeft=15;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1360" y="770" width="360" height="175" as="geometry"/></mxCell>

<!-- TOKEN DETAIL -->
<mxCell id="td" value="TOKEN BUCKET — DETAILED WORKING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=#843C0C;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="50" y="990" width="1050" height="50" as="geometry"/></mxCell>
<mxCell id="td1" value="&lt;b&gt;PARAMETERS&lt;/b&gt;&lt;br&gt;capacity = max number of tokens → maximum burst size&lt;br&gt;refillRate = tokens added per second → long-term rate&lt;br&gt;tokens = currently available permits&lt;br&gt;lastRefill = timestamp of last calculation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;fontSize=14;align=left;spacingLeft=12;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="50" y="1060" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="td2" value="&lt;b&gt;LAZY REFILL&lt;/b&gt;&lt;br&gt;No cron/scheduled task is required.&lt;br&gt;&lt;br&gt;On request:&lt;br&gt;elapsed = now − lastRefill&lt;br&gt;newTokens = elapsed × refillRate&lt;br&gt;tokens = min(capacity, tokens + newTokens)&lt;br&gt;lastRefill = now&lt;br&gt;&lt;br&gt;Why? No background job per user; fewer writes; scales better." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;fontSize=14;align=left;spacingLeft=12;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="370" y="1060" width="330" height="190" as="geometry"/></mxCell>
<mxCell id="td3" value="&lt;b&gt;CALCULATION EXAMPLE&lt;/b&gt;&lt;br&gt;capacity = 10&lt;br&gt;refillRate = 2 tokens/sec&lt;br&gt;initial tokens = 10&lt;br&gt;&lt;br&gt;After 5 sec:&lt;br&gt;new = 5 × 2 = 10&lt;br&gt;tokens = min(10, 10 + 10) = 10&lt;br&gt;&lt;br&gt;Request consumes 1 → tokens=9 → ALLOW." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=14;align=left;spacingLeft=12;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="720" y="1060" width="380" height="190" as="geometry"/></mxCell>

<mxCell id="flow" value="REQUEST FLOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=#843C0C;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="50" y="1280" width="1050" height="45" as="geometry"/></mxCell>
<mxCell id="r1" value="REQUEST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="50" y="1350" width="150" height="60" as="geometry"/></mxCell>
<mxCell id="r2" value="LOAD BUCKET STATE&lt;br&gt;tokens + lastRefill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;fontSize=13" vertex="1" parent="1"><mxGeometry x="230" y="1340" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="r3" value="REFILL LAZILY&lt;br&gt;based on elapsed time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;fontSize=13" vertex="1" parent="1"><mxGeometry x="440" y="1340" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="r4" value="TOKENS ≥ 1?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="650" y="1330" width="160" height="100" as="geometry"/></mxCell>
<mxCell id="r5" value="YES → decrement token → ALLOW&lt;br&gt;return response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="840" y="1330" width="210" height="85" as="geometry"/></mxCell>
<mxCell id="r6" value="NO → REJECT&lt;br&gt;HTTP 429 Too Many Requests&lt;br&gt;optionally Retry-After" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#CC0000;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="840" y="1435" width="210" height="95" as="geometry"/></mxCell>

<!-- DISTRIBUTED -->
<mxCell id="dist" value="DISTRIBUTED RATE LIMITING — MULTIPLE APP INSTANCES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7030A0;strokeColor=#4B1F6F;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="1150" y="990" width="1050" height="50" as="geometry"/></mxCell>
<mxCell id="arch" value="CLIENT → LOAD BALANCER → APP A / APP B / APP C&lt;br&gt;&lt;br&gt;All instances must see the SAME logical rate-limit state.&lt;br&gt;&lt;br&gt;If each instance keeps its own local counter, a 100 req/min limit becomes roughly 300 req/min across 3 instances.&lt;br&gt;&lt;br&gt;Therefore shared state is needed: Redis is a common choice because it is fast and supports atomic operations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#7030A0;fontSize=14;fontColor=#352348;align=left;spacingLeft=15;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1150" y="1060" width="500" height="190" as="geometry"/></mxCell>
<mxCell id="redis" value="REDIS&lt;br&gt;&lt;br&gt;key example:&lt;br&gt;rate_limit:user:123&lt;br&gt;&lt;br&gt;state can contain tokens + lastRefill&lt;br&gt;&lt;br&gt;&lt;b&gt;Atomic check + consume is critical.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#38761D;fontSize=14;fontColor=#274E13;align=left;spacingLeft=15;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1680" y="1060" width="300" height="190" as="geometry"/></mxCell>
<mxCell id="race" value="&lt;b&gt;RACE CONDITION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Remaining = 1&lt;br&gt;&lt;br&gt;Server A reads 1&lt;br&gt;Server B reads 1&lt;br&gt;A allows&lt;br&gt;B allows&lt;br&gt;&lt;br&gt;❌ 2 requests consumed 1 permit.&lt;br&gt;&lt;br&gt;&lt;b&gt;FIX:&lt;/b&gt; check + refill + consume + update timestamp must happen atomically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#CC0000;fontSize=14;fontColor=#5B0000;align=left;spacingLeft=15;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="2010" y="1060" width="190" height="190" as="geometry"/></mxCell>
<mxCell id="atomic" value="ATOMIC IMPLEMENTATION OPTIONS&lt;br&gt;&lt;br&gt;• Redis Lua script: perform entire calculation atomically&lt;br&gt;• Atomic Redis commands where algorithm permits&lt;br&gt;• Avoid read → calculate → write as separate network operations&lt;br&gt;&lt;br&gt;&lt;b&gt;Trade-off:&lt;/b&gt; stronger atomicity gives correctness but adds shared-state dependency." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#2F75B5;fontSize=14;fontColor=#17365D;align=left;spacingLeft=15;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1150" y="1280" width="500" height="200" as="geometry"/></mxCell>
<mxCell id="distmore" value="&lt;b&gt;DISTRIBUTED CONS / PROBLEMS&lt;/b&gt;&lt;br&gt;1. Redis/network latency on request path&lt;br&gt;2. Redis unavailable → choose fail-open or fail-closed&lt;br&gt;3. Hot key if one user/API gets huge traffic&lt;br&gt;4. Memory usage for many active keys&lt;br&gt;5. Expired keys need TTL/cleanup&lt;br&gt;6. Cross-region consistency can be difficult&lt;br&gt;7. Redis can become a bottleneck → shard/scale when necessary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=14;fontColor=#4A3B00;align=left;spacingLeft=15;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1680" y="1280" width="520" height="200" as="geometry"/></mxCell>

<!-- DIMENSIONS + HTTP + FAILURE -->
<mxCell id="dimension" value="WHAT ARE WE LIMITING?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#385723;fontColor=#FFFFFF;fontSize=19;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="50" y="1570" width="650" height="50" as="geometry"/></mxCell>
<mxCell id="dimb" value="&lt;b&gt;Per IP:&lt;/b&gt; protects public endpoints from anonymous abuse&lt;br&gt;&lt;b&gt;Per User:&lt;/b&gt; fair usage per authenticated user&lt;br&gt;&lt;b&gt;Per API Key:&lt;/b&gt; partner/developer quota&lt;br&gt;&lt;b&gt;Per Endpoint:&lt;/b&gt; expensive endpoint gets stricter limit&lt;br&gt;&lt;b&gt;Global:&lt;/b&gt; protect whole service/downstream dependency&lt;br&gt;&lt;b&gt;Hierarchical:&lt;/b&gt; e.g. global 10k/s + user 10/s + endpoint 2/s&lt;br&gt;&lt;br&gt;&lt;b&gt;Key design:&lt;/b&gt; choose a stable identifier and make it explicit in requirements." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=14;fontColor=#274E13;align=left;spacingLeft=15;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="50" y="1640" width="650" height="190" as="geometry"/></mxCell>

<mxCell id="http" value="HTTP / API BEHAVIOR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=19;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="750" y="1570" width="650" height="50" as="geometry"/></mxCell>
<mxCell id="httpb" value="&lt;b&gt;Allowed:&lt;/b&gt; normal 2xx response.&lt;br&gt;&lt;b&gt;Rejected:&lt;/b&gt; HTTP 429 Too Many Requests.&lt;br&gt;&lt;b&gt;Retry-After:&lt;/b&gt; tell client when retry may be appropriate if known.&lt;br&gt;&lt;b&gt;Headers can expose limits:&lt;/b&gt; limit / remaining / reset depending on API design.&lt;br&gt;&lt;br&gt;&lt;b&gt;Do not rely on client-side enforcement&lt;/b&gt; — the server/gateway is the source of truth." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#2F75B5;fontSize=14;fontColor=#17365D;align=left;spacingLeft=15;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="750" y="1640" width="650" height="190" as="geometry"/></mxCell>

<mxCell id="failure" value="FAILURE + OPERABILITY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7F6000;strokeColor=#5B4300;fontColor=#FFFFFF;fontSize=19;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="1450" y="1570" width="750" height="50" as="geometry"/></mxCell>
<mxCell id="failureb" value="&lt;b&gt;Redis down?&lt;/b&gt;&lt;br&gt;Fail-open → allow traffic; better availability, weaker protection.&lt;br&gt;Fail-closed → reject traffic; stronger protection, can cause outage.&lt;br&gt;Decision depends on endpoint criticality and business requirement.&lt;br&gt;&lt;br&gt;&lt;b&gt;Observability:&lt;/b&gt; allowed/rejected count • rate-limit latency • Redis latency/errors • top throttled users/keys • bucket saturation • 429 rate.&lt;br&gt;&lt;br&gt;&lt;b&gt;TTL:&lt;/b&gt; expire inactive user/API keys so state does not live forever.&lt;br&gt;&lt;b&gt;Hot keys:&lt;/b&gt; a single heavily used key can overload one Redis shard; design for sharding/partitioning if required." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=14;fontColor=#4A3B00;align=left;spacingLeft=15;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1450" y="1640" width="750" height="190" as="geometry"/>
</mxCell>

<!-- LLD checklist -->
<mxCell id="checktitle" value="SDE3 LLD — WHAT TO DISCUSS IN THE INTERVIEW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7030A0;strokeColor=#4B1F6F;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="50" y="1870" width="2150" height="55" as="geometry"/></mxCell>
<mxCell id="checkbody" value="&lt;b&gt;Requirements:&lt;/b&gt; define limit, time window, burst behavior, key (IP/user/API key), endpoint/global scope.&lt;br&gt;&lt;b&gt;Choose algorithm:&lt;/b&gt; Token Bucket is a strong default when bursts are allowed; explain alternatives and trade-offs.&lt;br&gt;&lt;b&gt;Storage:&lt;/b&gt; local memory for single instance; Redis/shared store for distributed instances.&lt;br&gt;&lt;b&gt;Concurrency:&lt;/b&gt; check + consume must be atomic; otherwise race conditions exceed limits.&lt;br&gt;&lt;b&gt;Performance:&lt;/b&gt; keep hot path O(1) where possible; avoid DB calls for every request.&lt;br&gt;&lt;b&gt;Failure:&lt;/b&gt; decide fail-open/fail-closed for Redis failures.&lt;br&gt;&lt;b&gt;Cleanup:&lt;/b&gt; TTL for inactive keys; avoid unbounded state.&lt;br&gt;&lt;b&gt;Response:&lt;/b&gt; 429 + optional Retry-After.&lt;br&gt;&lt;b&gt;Scaling:&lt;/b&gt; Redis sharding, hot-key strategy, cross-region considerations.&lt;br&gt;&lt;b&gt;Observability:&lt;/b&gt; rejection rate, latency, errors, saturation, noisy clients.&lt;br&gt;&lt;b&gt;Common follow-ups:&lt;/b&gt; How do you handle burst? What if Redis dies? What if two servers process simultaneously? How do you prevent memory growth? How do you support different limits for different users? How do you make it globally consistent?&lt;br&gt;&lt;br&gt;&lt;b&gt;Final mental model:&lt;/b&gt; REQUEST → identify key → read shared state → refill/estimate → atomically consume permit → ALLOW or 429." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#7030A0;fontSize=15;fontColor=#352348;align=left;spacingLeft=18;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="50" y="1945" width="2150" height="270" as="geometry"/>
</mxCell>

<!-- connectors -->
<mxCell id="c1" edge="1" parent="1" source="what" target="alg" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#2F75B5;strokeWidth=2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c2" edge="1" parent="1" source="alg" target="fixed" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;strokeColor=#BF9000"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c3" edge="1" parent="1" source="alg" target="log" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;strokeColor=#7F5AA2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c4" edge="1" parent="1" source="alg" target="counter" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;strokeColor=#6AA84F"><mxGeometry relative="1" as="geometry"/></mxCell>
