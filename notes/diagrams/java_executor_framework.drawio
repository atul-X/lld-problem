  <diagram id="page_74c3fa33be" name="04 - Pool Parameters">
    <mxGraphModel dx="2264" dy="918" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_8264dd8259" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:25px;font-weight:700;color:#123A78;margin-bottom:8px&#39;&gt;4. THREADPOOL CONFIGURATION — UNDERSTAND EVERY KNOB&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Never tune one number alone; pool size, queue size and task duration interact.&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="1520" x="40" y="25" as="geometry" />
        </mxCell>
        <mxCell id="c_5ae1d37157" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;corePoolSize&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Normal concurrency&lt;br&gt;&lt;br&gt;How many workers you want ready under normal load&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="410" x="70" y="160" as="geometry" />
        </mxCell>
        <mxCell id="c_7c7778e887" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;maximumPoolSize&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Burst ceiling&lt;br&gt;&lt;br&gt;Maximum workers when queue is saturated&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="410" x="550" y="160" as="geometry" />
        </mxCell>
        <mxCell id="c_b566f00dbd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;keepAliveTime&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Idle lifetime&lt;br&gt;&lt;br&gt;Excess/non-core workers can be removed after idle time&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="410" x="1030" y="160" as="geometry" />
        </mxCell>
        <mxCell id="c_d835651da8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;BlockingQueue&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Waiting area&lt;br&gt;&lt;br&gt;Tasks waiting for a worker; capacity can be bounded&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="410" x="70" y="390" as="geometry" />
        </mxCell>
        <mxCell id="c_72bc875ccf" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;ThreadFactory&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Thread identity&lt;br&gt;&lt;br&gt;Naming, daemon flag, priority, uncaught exception handler&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="410" x="550" y="390" as="geometry" />
        </mxCell>
        <mxCell id="c_1143125177" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;RejectedExecutionHandler&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Full-pool policy&lt;br&gt;&lt;br&gt;What to do when queue + max workers are saturated&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="410" x="1030" y="390" as="geometry" />
        </mxCell>
        <mxCell id="c_0951b3dc6d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B7A53;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#0B7A53;margin-bottom:7px&#39;&gt;Production-style constructor&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;ThreadPoolExecutor pool =&lt;br&gt;    new ThreadPoolExecutor(&lt;br&gt;        20,                        // corePoolSize&lt;br&gt;        50,                        // maximumPoolSize&lt;br&gt;        30, TimeUnit.SECONDS,      // keepAlive&lt;br&gt;        new ArrayBlockingQueue&amp;lt;&amp;gt;(200),&lt;br&gt;        threadFactory,&lt;br&gt;        new CallerRunsPolicy()&lt;br&gt;    );&lt;/div&gt;" vertex="1">
          <mxGeometry height="265" width="900" x="70" y="635" as="geometry" />
        </mxCell>
        <mxCell id="c_a157527dc3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Read this configuration as a story&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;“Normally run up to 20 workers.&lt;br&gt;Allow a burst toward 50 only after the queue fills.&lt;br&gt;Wait at most 200 tasks in the queue.&lt;br&gt;If still saturated, caller runs the work.”&lt;/div&gt;" vertex="1">
          <mxGeometry height="265" width="520" x="1010" y="635" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_936fd757b3" name="05 - Queue Types">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_4c246f4cc4" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:25px;font-weight:700;color:#123A78;margin-bottom:8px&#39;&gt;5. BLOCKING QUEUES — THIS IS WHERE MANY DEVELOPERS GET CONFUSED&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Queue selection changes whether the pool grows, waits, or rejects. Memorize these three.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="25" width="1520" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c_96df092f18" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;SynchronousQueue&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;CAPACITY: effectively 0&lt;br&gt;&lt;br&gt;Producer hands the task directly to a worker.&lt;br&gt;No queue backlog.&lt;br&gt;&lt;br&gt;Classic behavior behind cached-style executors.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="160" width="440" height="270" as="geometry" />
        </mxCell>
        <mxCell id="c_105c5d6f4d" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;LinkedBlockingQueue&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;CAPACITY: can be very large / bounded&lt;br&gt;&lt;br&gt;Tasks wait in the queue before extra workers are created.&lt;br&gt;&lt;br&gt;Default style used by fixed-thread-pool factory.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="580" y="160" width="440" height="270" as="geometry" />
        </mxCell>
        <mxCell id="c_2b32965bda" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;ArrayBlockingQueue&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;CAPACITY: fixed and bounded&lt;br&gt;&lt;br&gt;Useful when memory/backlog must have a known limit.&lt;br&gt;&lt;br&gt;Great for explicit production pools.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1090" y="160" width="440" height="270" as="geometry" />
        </mxCell>
        <mxCell id="c_6cb8931023" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;WHY QUEUE SIZE MATTERS&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;A huge queue can make the service look “healthy” while requests wait longer and longer.&lt;br&gt;A bounded queue makes overload visible and lets rejection/backpressure happen.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="470" width="1460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c_64996c37a4" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;BURSTY LOAD + SynchronousQueue&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;T1 → worker&lt;br&gt;T2 → worker&lt;br&gt;T3 → new worker&lt;br&gt;T4 → new worker&lt;br&gt;&lt;br&gt;No waiting room.&lt;br&gt;Threads can grow quickly.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="610" width="440" height="245" as="geometry" />
        </mxCell>
        <mxCell id="c_291bb4cc98" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;BURSTY LOAD + LARGE QUEUE&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;T1,T2 → workers&lt;br&gt;T3…T1000 → queue&lt;br&gt;&lt;br&gt;Workers may NOT grow beyond core&lt;br&gt;while queue is still accepting tasks.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="580" y="610" width="440" height="245" as="geometry" />
        </mxCell>
        <mxCell id="c_208220e7dc" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;BOUNDED QUEUE&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;T1… → workers + queue&lt;br&gt;Queue reaches limit&lt;br&gt;→ grow toward max&lt;br&gt;→ then reject&lt;br&gt;&lt;br&gt;Explicit overload boundary.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1090" y="610" width="440" height="245" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_ebecbbd79f" name="06 - Executor Types">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_e9e264ea06" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:25px;font-weight:700;color:#123A78;margin-bottom:8px&#39;&gt;6. EXECUTOR TYPES — WHEN TO USE EACH ONE&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Do not choose by habit. Match the executor to the workload.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="25" width="1520" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c_d2bbd63831" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;newFixedThreadPool(n)&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;WHAT: Stable worker count + queue&lt;br&gt;&lt;br&gt;WHEN: Predictable concurrency, CPU or controlled I/O&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="145" width="700" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c_b5367cb66f" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#2563EB;margin-bottom:7px&#39;&gt;JAVA&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;ExecutorService pool =&lt;br&gt;    Executors.newFixedThreadPool(8);&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="435" y="165" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_8e69736c22" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;newSingleThreadExecutor()&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;WHAT: Exactly one worker&lt;br&gt;&lt;br&gt;WHEN: Sequential local processing / ordered writes&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="820" y="145" width="700" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c_eed0ec96a7" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#059669;margin-bottom:7px&#39;&gt;JAVA&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;ExecutorService pool =&lt;br&gt;    Executors.newSingleThreadExecutor();&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1185" y="165" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_be07e10d61" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;newScheduledThreadPool(n)&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;WHAT: Delayed + periodic&lt;br&gt;&lt;br&gt;WHEN: Refresh, heartbeat, cleanup, polling&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="395" width="700" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c_d84a44d761" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#7C3AED;margin-bottom:7px&#39;&gt;JAVA&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;ScheduledExecutorService s =&lt;br&gt;    Executors.newScheduledThreadPool(2);&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="435" y="415" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_ac4e38b0ed" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;newCachedThreadPool()&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;WHAT: Dynamic workers + direct handoff&lt;br&gt;&lt;br&gt;WHEN: Short asynchronous tasks; dangerous under uncontrolled bursts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="820" y="395" width="700" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c_3aa079649b" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#EA580C;margin-bottom:7px&#39;&gt;JAVA&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;ExecutorService pool =&lt;br&gt;    Executors.newCachedThreadPool();&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1185" y="415" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_9e8f58df3b" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;newWorkStealingPool()&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;WHAT: ForkJoinPool-style workers&lt;br&gt;&lt;br&gt;WHEN: Many small CPU tasks / fork-join style decomposition&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="645" width="700" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c_4e732a26ec" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#D97706;margin-bottom:7px&#39;&gt;JAVA&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;ExecutorService pool =&lt;br&gt;    Executors.newWorkStealingPool();&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="435" y="665" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_9fe6a2e657" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;new ThreadPoolExecutor(...)&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;WHAT: Full control&lt;br&gt;&lt;br&gt;WHEN: Production systems needing explicit bounds/rejection/metrics&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="820" y="645" width="700" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c_2ce79b7015" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#16A34A;margin-bottom:7px&#39;&gt;JAVA&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;ExecutorService pool =&lt;br&gt;    new ThreadPoolExecutor(&lt;br&gt;      core, max, keepAlive,&lt;br&gt;      unit, queue, factory, handler);&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1185" y="665" width="380" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_589949cef2" name="07 - Future and Cancellation">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_ae32652c92" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:25px;font-weight:700;color:#123A78;margin-bottom:8px&#39;&gt;7. FUTURE&amp;lt;T&amp;gt; — RESULT, EXCEPTION, CANCELLATION, TIMEOUT&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Future is the handle you keep after submitting asynchronous work.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="25" width="1520" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c_e66eda8288" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;SUBMIT&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;submit(task)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="100" y="155" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_5b4387afe1" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;NEW&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Future&amp;lt;T&amp;gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="500" y="155" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_6ad23a4671" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;RUNNING&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Worker executes&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="900" y="155" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_260a1342c2" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;DONE&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;result / error&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1300" y="155" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_69a2819d9b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry x="0" y="0" width="0" height="0" as="geometry" relative="1">
            <mxPoint x="350" y="200" as="sourcePoint" />
            <mxPoint x="500" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_995c52895e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry x="0" y="0" width="0" height="0" as="geometry" relative="1">
            <mxPoint x="750" y="200" as="sourcePoint" />
            <mxPoint x="900" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_812582fe01" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry x="0" y="0" width="0" height="0" as="geometry" relative="1">
            <mxPoint x="1150" y="200" as="sourcePoint" />
            <mxPoint x="1300" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_af94098c51" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#2563EB;margin-bottom:7px&#39;&gt;GET — bounded wait&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;Future&amp;lt;Order&amp;gt; f =&lt;br&gt;    pool.submit(() -&amp;gt; createOrder());&lt;br&gt;&lt;br&gt;try {&lt;br&gt;    Order order =&lt;br&gt;        f.get(800, TimeUnit.MILLISECONDS);&lt;br&gt;} catch (TimeoutException e) {&lt;br&gt;    f.cancel(true);&lt;br&gt;}&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="315" width="470" height="270" as="geometry" />
        </mxCell>
        <mxCell id="c_7e48edab36" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;isDone() / isCancelled()&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;isDone() → completed OR cancelled&lt;br&gt;&lt;br&gt;isCancelled() → cancellation succeeded&lt;br&gt;&lt;br&gt;Cancellation is a request; the task must cooperate with interruption.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="590" y="315" width="440" height="270" as="geometry" />
        </mxCell>
        <mxCell id="c_4feb2827a6" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#DC2626;margin-bottom:7px&#39;&gt;CANCEL&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;boolean cancelled =&lt;br&gt;    future.cancel(true);&lt;br&gt;&lt;br&gt;// true means:&lt;br&gt;// “please interrupt if running”&lt;br&gt;// not “kill the thread immediately”&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1080" y="315" width="450" height="270" as="geometry" />
        </mxCell>
        <mxCell id="c_074ada5797" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;EXCEPTION FLOW&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Task throws → Future stores failure&lt;br&gt;&lt;br&gt;future.get() throws ExecutionException&lt;br&gt;&lt;br&gt;Use getCause() to inspect the original exception.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="630" width="700" height="235" as="geometry" />
        </mxCell>
        <mxCell id="c_14ab18ee0f" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;COMMON PITFALL&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;future.get() with no timeout can block a request thread indefinitely.&lt;br&gt;&lt;br&gt;For external I/O, combine executor control with dependency timeouts + bounded Future waits.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="830" y="630" width="700" height="235" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_a99210caeb" name="08 - invokeAll and invokeAny">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_121a260dd7" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:25px;font-weight:700;color:#123A78;margin-bottom:8px&#39;&gt;8. FAN-OUT — PARALLEL TASKS WITHOUT MANUALLY MANAGING THREADS&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Useful when one operation can be decomposed into independent calls.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="25" width="1520" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c_f6610ac8c5" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;invokeAll(tasks)&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;You need ALL task results&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="155" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_a316d8f65e" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Profile&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:13px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;call&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="100" y="285" width="140" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c_4d31e3e29c" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Offers&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:13px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;call&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="260" y="285" width="140" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c_aeeb070bdf" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Rewards&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:13px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;call&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="420" y="285" width="140" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c_03f32bb82c" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Limits&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:13px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;call&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="580" y="285" width="140" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c_53e7c9ddaf" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;RESULT&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;List&amp;lt;Future&amp;lt;T&amp;gt;&amp;gt;&lt;br&gt;&lt;br&gt;The call waits until all submitted tasks finish (or timeout if using timed overload).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="390" width="700" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_40cdf01810" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#2563EB;margin-bottom:7px&#39;&gt;CASE STUDY — API AGGREGATOR&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;List&amp;lt;Callable&amp;lt;Data&amp;gt;&amp;gt; tasks =&lt;br&gt;    List.of(&lt;br&gt;      () -&amp;gt; profileClient.get(),&lt;br&gt;      () -&amp;gt; offerClient.get(),&lt;br&gt;      () -&amp;gt; rewardClient.get()&lt;br&gt;    );&lt;br&gt;&lt;br&gt;List&amp;lt;Future&amp;lt;Data&amp;gt;&amp;gt; fs =&lt;br&gt;    pool.invokeAll(tasks);&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="570" width="700" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c_bc878f3d1e" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;invokeAny(tasks)&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;You need ONE successful result&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="830" y="155" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_ca0babea64" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Replica A&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:13px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;call&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="860" y="285" width="170" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c_47c23fb488" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Replica B&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:13px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;call&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1060" y="285" width="170" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c_26dba34983" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Replica C&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:13px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;call&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1260" y="285" width="170" height="75" as="geometry" />
        </mxCell>
        <mxCell id="c_800c187105" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;RESULT&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Returns the first successfully completed result.&lt;br&gt;Unfinished tasks are cancelled by the executor after one succeeds.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="830" y="390" width="700" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_236ea1e1c3" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#7C3AED;margin-bottom:7px&#39;&gt;CASE STUDY — REDUNDANT READ&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;Data result =&lt;br&gt;    pool.invokeAny(List.of(&lt;br&gt;      () -&amp;gt; replicaA.read(key),&lt;br&gt;      () -&amp;gt; replicaB.read(key),&lt;br&gt;      () -&amp;gt; replicaC.read(key)&lt;br&gt;    ));&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="830" y="570" width="700" height="250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_f770f281a8" name="09 - Scheduling">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_1eea226e2a" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:25px;font-weight:700;color:#123A78;margin-bottom:8px&#39;&gt;9. SCHEDULED EXECUTOR — DELAYED VS PERIODIC EXECUTION&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Use the dedicated scheduling API instead of creating sleep-based worker loops.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="25" width="1520" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c_39cb64b262" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#7C3AED;margin-bottom:7px&#39;&gt;schedule() — run once after delay&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;scheduler.schedule(&lt;br&gt;    () -&amp;gt; refreshCache(),&lt;br&gt;    10,&lt;br&gt;    TimeUnit.SECONDS&lt;br&gt;);&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="150" width="700" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c_1c7a4355e2" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;WHEN&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;One-shot delayed task.&lt;br&gt;&lt;br&gt;Examples:&lt;br&gt;• delayed notification&lt;br&gt;• retry after backoff&lt;br&gt;• cache warm-up&lt;br&gt;• cleanup after grace period&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="830" y="150" width="700" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c_1be11ba849" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#2563EB;margin-bottom:7px&#39;&gt;scheduleAtFixedRate()&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;scheduler.scheduleAtFixedRate(&lt;br&gt;    this::publishMetrics,&lt;br&gt;    0,&lt;br&gt;    30,&lt;br&gt;    TimeUnit.SECONDS&lt;br&gt;);&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="440" width="700" height="280" as="geometry" />
        </mxCell>
        <mxCell id="c_deed5f05ea" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;FIXED RATE&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Attempts to maintain a regular cadence.&lt;br&gt;&lt;br&gt;Useful for heartbeat / metrics / refresh jobs.&lt;br&gt;&lt;br&gt;Be careful when a single run takes longer than the period.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="830" y="440" width="700" height="280" as="geometry" />
        </mxCell>
        <mxCell id="c_085268a223" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#059669;margin-bottom:7px&#39;&gt;scheduleWithFixedDelay()&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;scheduler.scheduleWithFixedDelay(&lt;br&gt;    this::poll,&lt;br&gt;    0,&lt;br&gt;    5,&lt;br&gt;    TimeUnit.SECONDS&lt;br&gt;);&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="755" width="700" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c_f494f8bcee" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;FIXED DELAY&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Delay starts AFTER the previous execution completes.&lt;br&gt;Useful for polling loops where you want spacing between runs.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="830" y="755" width="700" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_ed129fb1df" name="10 - Rejection Backpressure">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_48c3f25a4e" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:25px;font-weight:700;color:#123A78;margin-bottom:8px&#39;&gt;10. REJECTION POLICIES — WHAT SHOULD HAPPEN WHEN THE SYSTEM IS FULL?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Saturation is not an edge case. It is the moment your design reveals its overload strategy.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="25" width="1520" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c_68644e2b02" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;AbortPolicy&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;ACTION: throw RejectedExecutionException&lt;br&gt;&lt;br&gt;WHEN: Good default when caller must know the system is saturated.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="155" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c_b06d01da31" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;CallerRunsPolicy&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;ACTION: caller runs the task&lt;br&gt;&lt;br&gt;WHEN: Simple backpressure: producer becomes slower.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="820" y="155" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c_f381e0a071" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;DiscardPolicy&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;ACTION: drop new task silently&lt;br&gt;&lt;br&gt;WHEN: Only when work is intentionally lossy.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="405" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c_e0b67756a8" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;DiscardOldestPolicy&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;ACTION: drop queue head, retry&lt;br&gt;&lt;br&gt;WHEN: Rare; only when newest work is more valuable.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="820" y="405" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c_7f241e6cbe" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;BACKPRESSURE STORY&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;CallerRunsPolicy can turn:&lt;br&gt;“system is overloaded”&lt;br&gt;into:&lt;br&gt;“producer is forced to slow down.”&lt;br&gt;&lt;br&gt;That is often safer than unlimited queue growth.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="680" width="700" height="235" as="geometry" />
        </mxCell>
        <mxCell id="c_5a1ad7cf83" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;DO NOT DO THIS BLINDLY&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Do not discard payment tasks, critical updates or security events unless the business explicitly allows loss.&lt;br&gt;&lt;br&gt;Choose rejection based on semantics, not convenience.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="830" y="680" width="700" height="235" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_a5df0f3fd5" name="11 - Production Case Study">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_f5ce59b76d" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:25px;font-weight:700;color:#123A78;margin-bottom:8px&#39;&gt;11. END-TO-END CASE STUDY — BUILD A SAFE PAYMENT WORKER POOL&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;This combines sizing, queueing, timeouts, rejection, thread naming and shutdown into one realistic example.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="25" width="1520" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c_004786acd3" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#0B7A53;margin-bottom:7px&#39;&gt;FULL JAVA EXAMPLE&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;ThreadFactory factory =&lt;br&gt;    runnable -&amp;gt; {&lt;br&gt;        Thread t = new Thread(runnable);&lt;br&gt;        t.setName(&amp;quot;bank-pool-&amp;quot; + t.getId());&lt;br&gt;        return t;&lt;br&gt;    };&lt;br&gt;&lt;br&gt;ThreadPoolExecutor pool =&lt;br&gt;    new ThreadPoolExecutor(&lt;br&gt;        20,                          // core&lt;br&gt;        50,                          // max&lt;br&gt;        30, TimeUnit.SECONDS,        // keepAlive&lt;br&gt;        new ArrayBlockingQueue&amp;lt;&amp;gt;(200),&lt;br&gt;        factory,&lt;br&gt;        new ThreadPoolExecutor.CallerRunsPolicy()&lt;br&gt;    );&lt;br&gt;&lt;br&gt;Future&amp;lt;BankResponse&amp;gt; future =&lt;br&gt;    pool.submit(() -&amp;gt; bankClient.charge(request));&lt;br&gt;&lt;br&gt;try {&lt;br&gt;    BankResponse response =&lt;br&gt;        future.get(800, TimeUnit.MILLISECONDS);&lt;br&gt;    return response;&lt;br&gt;} catch (TimeoutException e) {&lt;br&gt;    future.cancel(true);&lt;br&gt;    throw new PaymentTimeoutException(e);&lt;br&gt;} catch (ExecutionException e) {&lt;br&gt;    throw new PaymentFailedException(e.getCause());&lt;br&gt;}&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B7A53;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="150" width="900" height="640" as="geometry" />
        </mxCell>
        <mxCell id="c_949c683e32" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;WHY core=20?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Enough normal concurrency for expected I/O wait without allowing unbounded worker growth.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1020" y="150" width="510" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c_7200cc1a59" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;WHY max=50?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Allows a burst only after the queue is full. This is a ceiling, not the normal target.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1020" y="325" width="510" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c_54815c516d" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;WHY queue=200?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Absorbs short bursts but creates a visible overload boundary.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1020" y="500" width="510" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c_76b1944319" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;WHY timeout=800 ms?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Prevents a slow bank dependency from tying up application threads indefinitely.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1020" y="675" width="510" height="145" as="geometry" />
        </mxCell>
        <mxCell id="c_22afb75e65" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;OPERATIONS / METRICS&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Track activeCount • poolSize • queue size • completedTaskCount • rejection count • task latency p50/p95/p99 • dependency timeout rate&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="825" width="1460" height="105" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_f4703fb6d2" name="12 - CPU vs I/O Sizing">
    <mxGraphModel dx="2264" dy="918" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_3b64ade711" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:25px;font-weight:700;color:#123A78;margin-bottom:8px&#39;&gt;12. HOW MANY THREADS? — CPU-BOUND VS I/O-BOUND&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;There is no universal thread count. Start with workload characteristics, then measure.&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="1520" x="40" y="25" as="geometry" />
        </mxCell>
        <mxCell id="c_1f0932ffc6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;CPU-BOUND&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Examples: hashing, compression, image transforms, heavy calculations&lt;br&gt;&lt;br&gt;Starting point:&lt;br&gt;threads ≈ availableProcessors()&lt;br&gt;&lt;br&gt;Too many threads → context switching + cache pressure&lt;br&gt;&lt;br&gt;Measure CPU utilization and throughput.&lt;/div&gt;" vertex="1">
          <mxGeometry height="285" width="700" x="70" y="155" as="geometry" />
        </mxCell>
        <mxCell id="c_0cac65d8e3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#2563EB;margin-bottom:7px&#39;&gt;STARTING CODE&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;int cores =&lt;br&gt;    Runtime.getRuntime().availableProcessors();&lt;br&gt;&lt;br&gt;ExecutorService cpuPool =&lt;br&gt;    Executors.newFixedThreadPool(cores);&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="700" x="70" y="475" as="geometry" />
        </mxCell>
        <mxCell id="c_ba4f48d68f" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;I/O-BOUND&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Examples: DB calls, HTTP calls, file/network wait&lt;br&gt;&lt;br&gt;Threads can spend a lot of time blocked.&lt;br&gt;&lt;br&gt;A pool larger than core count may help throughput,&lt;br&gt;but keep concurrency bounded and respect downstream capacity.&lt;/div&gt;" vertex="1">
          <mxGeometry height="285" width="700" x="830" y="155" as="geometry" />
        </mxCell>
        <mxCell id="c_c36a444e2d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#059669;margin-bottom:7px&#39;&gt;STARTING CODE&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;ThreadPoolExecutor ioPool =&lt;br&gt;    new ThreadPoolExecutor(&lt;br&gt;        20, 50,&lt;br&gt;        30, SECONDS,&lt;br&gt;        new ArrayBlockingQueue&amp;lt;&amp;gt;(200),&lt;br&gt;        factory,&lt;br&gt;        new CallerRunsPolicy()&lt;br&gt;    );&lt;/div&gt;" vertex="1">
          <mxGeometry height="225" width="700" x="820" y="468" as="geometry" />
        </mxCell>
        <mxCell id="c_1fca833678" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;DO NOT USE THE FORMULA BLINDLY&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;The “right” size depends on task duration, CPU availability, downstream limits, request rate and latency target.&lt;br&gt;Use load testing + metrics to validate the configuration.&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="1460" x="70" y="720" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_2a5752e571" name="13 - Common Mistakes">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_c5ab2f4e25" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:25px;font-weight:700;color:#123A78;margin-bottom:8px&#39;&gt;13. COMMON MISTAKES — AND THE DESIGN FIX&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Use this page as a debugging checklist when you see latency spikes, OOMs or stuck requests.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="25" width="1520" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c_ecbbe57773" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;new Thread() per request&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;WHY IT HURTS: Thread creation overhead + difficult lifecycle control&lt;br&gt;&lt;br&gt;FIX: Use a bounded executor&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="145" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c_25d4291b5a" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Unbounded queue&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;WHY IT HURTS: Backlog grows silently → latency + memory pressure&lt;br&gt;&lt;br&gt;FIX: Bound the queue + define rejection&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="820" y="145" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c_c424dbdf3b" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;newCachedThreadPool() on untrusted traffic&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;WHY IT HURTS: Potentially huge number of workers&lt;br&gt;&lt;br&gt;FIX: Bound concurrency explicitly&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="395" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c_db5136ee1b" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Future.get() forever&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;WHY IT HURTS: Request threads can wait forever&lt;br&gt;&lt;br&gt;FIX: Use get(timeout) + dependency timeout&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="820" y="395" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c_4b0d79f258" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;One global pool for unrelated work&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;WHY IT HURTS: CPU jobs can starve I/O jobs&lt;br&gt;&lt;br&gt;FIX: Separate pools by workload / priority&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="645" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c_774ec77d98" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Ignoring shutdown&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;WHY IT HURTS: Worker threads leak / app may not terminate cleanly&lt;br&gt;&lt;br&gt;FIX: Own the lifecycle and shut down&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="820" y="645" width="700" height="205" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_c0165b7e81" name="14 - Interview Cheat Sheet">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_f798d95c78" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:25px;font-weight:700;color:#123A78;margin-bottom:8px&#39;&gt;14. INTERVIEW CHEAT SHEET — THE ANSWERS YOU SHOULD HAVE READY&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;This final page compresses the whole guide into the questions interviewers commonly probe.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="25" width="1520" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c_4d0760770b" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:18px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;What is Executor Framework?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Separates task submission from execution and manages worker lifecycle + concurrency.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="145" width="700" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c_d70afd0ed0" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:18px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;execute vs submit?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;execute = no result; submit = Future + result/error/cancellation.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="300" width="700" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c_3fe93c571d" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:18px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Runnable vs Callable?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Runnable returns void; Callable&amp;lt;T&amp;gt; returns T and can throw checked exceptions.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="455" width="700" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c_3c3e022584" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:18px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;How does ThreadPoolExecutor choose?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;core threads → queue → max threads → rejection.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="610" width="700" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c_1afe8d47a1" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:18px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Why use bounded queue?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Make overload visible and prevent unbounded memory/latency growth.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="70" y="765" width="700" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c_ee25a27b9f" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:18px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;When use CallerRunsPolicy?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;When slowing the producer is acceptable and useful as backpressure.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="820" y="145" width="700" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c_fc8fcb9066" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:18px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;shutdown vs shutdownNow?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;shutdown is graceful; shutdownNow is best-effort interruption.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="820" y="300" width="700" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c_5b67ccf796" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:18px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;invokeAll vs invokeAny?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;invokeAll needs all results; invokeAny needs first successful result.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="820" y="455" width="700" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c_3ad3c63f7f" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:18px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;CPU vs I/O pool?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;CPU tends toward core-count-sized; I/O may use more concurrency but must be bounded.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="820" y="610" width="700" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c_6036d6afa6" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:18px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;What do you monitor?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;pool size, active count, queue size, completed tasks, rejections, latency, timeouts.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="820" y="765" width="700" height="125" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
