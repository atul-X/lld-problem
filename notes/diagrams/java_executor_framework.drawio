          </mxGeometry>
        </mxCell>
        <mxCell id="c_a86cc1fe09" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;THREADPOOLEXECUTOR&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Concrete implementation: worker threads + queue + sizing policy + rejection policy + lifecycle&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="700" x="445" y="320" as="geometry" />
        </mxCell>
        <mxCell id="c_8f196736ad" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=3;endArrow=block;endFill=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1395" y="270" as="sourcePoint" />
            <mxPoint x="795" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_054a72ca84" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF0;strokeColor=#16A34A;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;1. CORE WORKERS&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;If worker count &amp;lt; corePoolSize:&lt;br&gt;→ create worker&lt;br&gt;→ worker runs task&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="320" x="90" y="510" as="geometry" />
        </mxCell>
        <mxCell id="c_7fee43b32b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;2. QUEUE&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Otherwise:&lt;br&gt;→ put task in BlockingQueue&lt;br&gt;&lt;br&gt;Waiting tasks accumulate here.&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="320" x="465" y="510" as="geometry" />
        </mxCell>
        <mxCell id="c_692694a51d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;3. EXTRA WORKERS&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;If queue is full and worker count &amp;lt; maximumPoolSize:&lt;br&gt;→ create extra worker&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="320" x="840" y="510" as="geometry" />
        </mxCell>
        <mxCell id="c_9b118c4106" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;4. REJECT&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;If queue full + max reached:&lt;br&gt;→ RejectedExecutionHandler&lt;br&gt;&lt;br&gt;System must decide what to do.&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="320" x="1215" y="510" as="geometry" />
        </mxCell>
        <mxCell id="c_d3232d14dc" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="630" as="sourcePoint" />
            <mxPoint x="465" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_637d457a72" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="785" y="630" as="sourcePoint" />
            <mxPoint x="840" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_71ddea4b45" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1160" y="630" as="sourcePoint" />
            <mxPoint x="1215" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_85bf56d837" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;RESULT SIDE&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;submit() → Future&amp;lt;T&amp;gt;&lt;br&gt;Future.get() → result (may block)&lt;br&gt;Future.cancel() → cancellation request&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="680" x="90" y="800" as="geometry" />
        </mxCell>
        <mxCell id="c_c2e0e63117" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;LIFECYCLE SIDE&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;shutdown() → stop accepting new tasks, finish existing work&lt;br&gt;shutdownNow() → best-effort interruption&lt;br&gt;awaitTermination() → wait for termination&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="735" x="800" y="800" as="geometry" />
        </mxCell>
        <mxCell id="c_d814aa3c58" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:18px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;CORE IDEA&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:18px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Executor Framework = concurrency control, not merely thread creation.&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="1445" x="90" y="950" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_b07705b485" name="02 - Interfaces and Methods">
    <mxGraphModel dx="2026" dy="942" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_468516d1ac" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:25px;font-weight:700;color:#123A78;margin-bottom:8px&#39;&gt;2. INTERFACES + METHODS — WHAT EACH API ACTUALLY MEANS&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Read this page when you forget which interface exposes which operation.&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="1520" x="40" y="25" as="geometry" />
        </mxCell>
        <mxCell id="c_2eff24b5f7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Executor&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;execute(Runnable)&lt;br&gt;Lowest-level contract&lt;br&gt;No return value&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="330" x="70" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c_87e92d0672" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;ExecutorService&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;submit()&lt;br&gt;invokeAll()&lt;br&gt;invokeAny()&lt;br&gt;shutdown()&lt;br&gt;awaitTermination()&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="330" x="450" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c_1f104e59b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;AbstractExecutorService&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Provides common FutureTask-based submit/invoke behavior.&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="330" x="830" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c_716c385098" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;ThreadPoolExecutor&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Concrete pool implementation.&lt;br&gt;Directly exposes tuning knobs.&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="320" x="1210" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c_3a9761ace7" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="222" as="sourcePoint" />
            <mxPoint x="450" y="222" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_2407367c33" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="780" y="222" as="sourcePoint" />
            <mxPoint x="830" y="222" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_e1aee755ee" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1160" y="222" as="sourcePoint" />
            <mxPoint x="1210" y="222" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_137af92651" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#2563EB;margin-bottom:7px&#39;&gt;execute() — no result&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;ExecutorService pool =&lt;br&gt;    Executors.newFixedThreadPool(4);&lt;br&gt;&lt;br&gt;pool.execute(() -&amp;gt; {&lt;br&gt;    auditLogger.info(&amp;quot;done&amp;quot;);&lt;br&gt;});&lt;/div&gt;" vertex="1">
          <mxGeometry height="265" width="460" x="70" y="340" as="geometry" />
        </mxCell>
        <mxCell id="c_a7ebf3a484" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Use when&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;You do not need a return value.&lt;br&gt;Examples: metrics, logging, fire-and-forget work.&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="460" x="70" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c_1474789c84" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#7C3AED;margin-bottom:7px&#39;&gt;submit() — Future result&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;Future&amp;lt;Integer&amp;gt; f =&lt;br&gt;    pool.submit(() -&amp;gt; {&lt;br&gt;        return calculate();&lt;br&gt;    });&lt;br&gt;&lt;br&gt;Integer value =&lt;br&gt;    f.get(500, TimeUnit.MILLISECONDS);&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="460" x="570" y="340" as="geometry" />
        </mxCell>
        <mxCell id="c_47eaee0276" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Use when&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;You need result, exception visibility, cancellation or completion state.&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="460" x="570" y="655" as="geometry" />
        </mxCell>
        <mxCell id="c_ade2dc41b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;spacing=9;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;font-weight:700;color:#059669;margin-bottom:7px&#39;&gt;Callable&amp;lt;T&amp;gt;&lt;/div&gt;&lt;div style=&#39;font-family:monospace;font-size:14px;line-height:1.32;color:#111827;background:#F8FAFC;padding:9px;border:1px solid #CBD5E1;border-radius:6px&#39;&gt;Callable&amp;lt;String&amp;gt; task = () -&amp;gt; {&lt;br&gt;    if (!service.isHealthy()) {&lt;br&gt;        throw new Exception(&amp;quot;down&amp;quot;);&lt;br&gt;    }&lt;br&gt;    return fetchData();&lt;br&gt;};&lt;br&gt;&lt;br&gt;Future&amp;lt;String&amp;gt; f = pool.submit(task);&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="460" x="1070" y="340" as="geometry" />
        </mxCell>
        <mxCell id="c_bb268c5119" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;Key difference&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Runnable → run() → void&lt;br&gt;Callable&amp;lt;T&amp;gt; → call() → T + checked exceptions&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="460" x="1070" y="655" as="geometry" />
        </mxCell>
        <mxCell id="c_f0a976b7d6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;invokeAll() vs invokeAny()&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:17px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;invokeAll(tasks) → wait for ALL tasks → List&amp;lt;Future&amp;lt;T&amp;gt;&amp;gt;&lt;br&gt;invokeAny(tasks) → return first successful result → other unfinished tasks are cancelled&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="1460" x="70" y="800" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_c26840650c" name="03 - Submission Algorithm">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
