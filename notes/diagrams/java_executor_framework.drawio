        </mxCell>
        <mxCell id="c_ee6e896461" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;YES&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Enqueue task&lt;br&gt;Worker will take it later&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
