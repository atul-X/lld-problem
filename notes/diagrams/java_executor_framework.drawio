  <diagram id="page_341075431c" name="01 - Big Picture">
    <mxGraphModel dx="1720" dy="1047" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_03e37ae815" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:25px;font-weight:700;color:#123A78;margin-bottom:8px&#39;&gt;1. BIG PICTURE — WHAT PROBLEM DOES EXECUTOR FRAMEWORK SOLVE?&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:15px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;One mental model: your code submits work; the executor controls concurrency and owns the worker lifecycle.&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="1520" x="40" y="25" as="geometry" />
        </mxCell>
        <mxCell id="c_442877c902" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;APPLICATION&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Business code&lt;br&gt;HTTP request / message / scheduler / controller&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="300" x="70" y="155" as="geometry" />
        </mxCell>
        <mxCell id="c_ee5a1eff9a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;TASK&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;Runnable → no result&lt;br&gt;Callable&amp;lt;T&amp;gt; → result&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="300" x="470" y="155" as="geometry" />
        </mxCell>
        <mxCell id="c_c9d94d3512" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;EXECUTOR&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;execute(Runnable)&lt;br&gt;Accept work&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="300" x="870" y="155" as="geometry" />
        </mxCell>
        <mxCell id="c_45be038b5f" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" value="&lt;div style=&#39;font-family:Arial,sans-serif;font-size:19px;font-weight:700;color:#0F172A;margin-bottom:8px&#39;&gt;EXECUTOR SERVICE&lt;/div&gt;&lt;div style=&#39;font-family:Arial,sans-serif;font-size:16px;line-height:1.28;color:#1F2937;text-align:left&#39;&gt;submit / invokeAll / shutdown&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="250" x="1270" y="155" as="geometry" />
        </mxCell>
