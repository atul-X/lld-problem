        <mxCell id="c_df5861b7b9" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" value="">
          <mxGeometry relative="1" as="geometry">
