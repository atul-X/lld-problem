  <diagram id="page_7ef0d7c4d2" name="17 - Final Mental Model">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_cea3467d0e" value="&lt;div style='font-family:Arial;font-size:26px;font-weight:700;color:#0F172A;margin-bottom:7px'&gt;17. FINAL KAFKA MENTAL MODEL&lt;/div&gt;&lt;div style='font-family:Arial;font-size:15px;line-height:1.28;color:#1F2937'&gt;Reconstruct Kafka from immutable logs + partitioning + replication + independent consumers.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="35" y="20" width="1530" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c_4db7d18c0f" value="&lt;div style='font-family:Arial;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:7px'&gt;1. PRODUCE&lt;/div&gt;&lt;div style='font-family:Arial;font-size:16px;line-height:1.28;color:#1F2937'&gt;event&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="80" y="150" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c_b60e4b6a77" value="&lt;div style='font-family:Arial;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:7px'&gt;2. PARTITION&lt;/div&gt;&lt;div style='font-family:Arial;font-size:16px;line-height:1.28;color:#1F2937'&gt;key → partition&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="420" y="150" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c_8115928935" value="&lt;div style='font-family:Arial;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:7px'&gt;3. APPEND&lt;/div&gt;&lt;div style='font-family:Arial;font-size:16px;line-height:1.28;color:#1F2937'&gt;leader log&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="760" y="150" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c_b14708f18e" value="&lt;div style='font-family:Arial;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:7px'&gt;4. REPLICATE&lt;/div&gt;&lt;div style='font-family:Arial;font-size:16px;line-height:1.28;color:#1F2937'&gt;followers / ISR&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1100" y="150" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c_37037162b2" value="&lt;div style='font-family:Arial;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:7px'&gt;5. RETAIN&lt;/div&gt;&lt;div style='font-family:Arial;font-size:16px;line-height:1.28;color:#1F2937'&gt;delete / compact&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="80" y="350" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c_a5ae9faa6e" value="&lt;div style='font-family:Arial;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:7px'&gt;6. POLL&lt;/div&gt;&lt;div style='font-family:Arial;font-size:16px;line-height:1.28;color:#1F2937'&gt;consumer reads&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="420" y="350" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c_dece50f9d0" value="&lt;div style='font-family:Arial;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:7px'&gt;7. COMMIT&lt;/div&gt;&lt;div style='font-family:Arial;font-size:16px;line-height:1.28;color:#1F2937'&gt;offset progress&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="760" y="350" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c_c758534894" value="&lt;div style='font-family:Arial;font-size:21px;font-weight:700;color:#0F172A;margin-bottom:7px'&gt;8. REPLAY&lt;/div&gt;&lt;div style='font-family:Arial;font-size:16px;line-height:1.28;color:#1F2937'&gt;seek old offset&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1100" y="350" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c_bdb0bb9470" value="&lt;div style='font-family:Arial;font-size:23px;font-weight:700;color:#0F172A;margin-bottom:7px'&gt;THE SINGLE SENTENCE&lt;/div&gt;&lt;div style='font-family:Arial;font-size:18px;line-height:1.28;color:#1F2937'&gt;Kafka is a distributed, partitioned append log where producers write records, brokers replicate partition logs, and consumer groups read independently by tracking offsets.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="170" y="560" width="1180" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_3bc17b2269" value="&lt;div style='font-family:Arial;font-size:22px;font-weight:700;color:#0F172A;margin-bottom:7px'&gt;THE THINGS TO KNOW&lt;/div&gt;&lt;div style='font-family:Arial;font-size:18px;line-height:1.28;color:#1F2937'&gt;Event → Topic → Partition → Broker → Replication/ISR → Producer → Consumer Group/Offset → Retention/Compaction → KRaft → Connect&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3B82F6;strokeWidth=2;spacing=10;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="170" y="760" width="1180" height="135" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
